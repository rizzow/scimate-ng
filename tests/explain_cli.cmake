file(MAKE_DIRECTORY "${FIXTURE_DIR}")
string(ASCII 255 ff)
file(WRITE "${FIXTURE_DIR}/resource.map" "${ff}${ff}${ff}${ff}${ff}${ff}")

function(check expected_code expected_pattern)
  execute_process(COMMAND "${CLI}" ${ARGN}
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${code}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "Unexpected explain exit ${code}: ${error}")
  endif()
  if(NOT "${output}${error}" MATCHES "${expected_pattern}")
    message(FATAL_ERROR "Missing explain output ${expected_pattern}: ${output}${error}")
  endif()
endfunction()

check(0 "Explain SCI0 resources" explain --help)
check(0 "Explain SCI0 resources" help explain)
check(0 "static heuristics" explain "${FIXTURE_DIR}")
check(0 "Selector names unavailable" explain --format sci0 -- "${FIXTURE_DIR}")
check(1 "was not found" explain "${FIXTURE_DIR}" view 42)
check(2 "Focus must be" explain "${FIXTURE_DIR}" view -1)
check(2 "Focus must be" explain "${FIXTURE_DIR}" view 2048)
check(2 "Focus must be" explain "${FIXTURE_DIR}" view 42junk)
check(2 "Focus must be" explain "${FIXTURE_DIR}" room 100)
check(2 "Usage:" explain "${FIXTURE_DIR}" view)
check(2 "Usage:" explain --raw "${FIXTURE_DIR}")
check(2 "Usage:" explain --format sci1 "${FIXTURE_DIR}")
check(2 "Usage:" explain --format sci0 --format sci0 "${FIXTURE_DIR}")
check(2 "Usage:" explain --json --json "${FIXTURE_DIR}")
execute_process(COMMAND "${CLI}" explain --json "${FIXTURE_DIR}"
  RESULT_VARIABLE json_code OUTPUT_VARIABLE json_output ERROR_VARIABLE json_error)
if(NOT json_code EQUAL 0)
  message(FATAL_ERROR "JSON explain failed: ${json_error}")
endif()
string(JSON schema GET "${json_output}" schema_version)
string(JSON reference_count LENGTH "${json_output}" references)
if(NOT schema EQUAL 1 OR NOT reference_count EQUAL 0)
  message(FATAL_ERROR "Unexpected JSON explanation: ${json_output}")
endif()
