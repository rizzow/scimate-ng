string(RANDOM LENGTH 12 suffix)
set(root "${FIXTURE_DIR}/${suffix}")
file(MAKE_DIRECTORY "${root}")
execute_process(COMMAND "${FIXTURE_WRITER}" --write-fixture "${root}/game" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not generate view CLI fixture")
endif()
function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "${ARGN}: unexpected exit ${code}: ${out} ${err}")
  endif()
endfunction()
run(0 inspect --format sci0 "${root}/game")
run(0 export --format sci0 "${root}/game" "${root}/export")
run(0 import --format sci0 "${root}/export" "${root}/rebuilt")
foreach(name resource.map resource.001 resource.002)
  file(SHA256 "${root}/game/${name}" before)
  file(SHA256 "${root}/rebuilt/${name}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Unchanged view game differs: ${name}")
  endif()
endforeach()
run(0 view-export --format sci0 "${root}/export/payloads/0000000.bin" "${root}/standalone")
run(0 view-import --format sci0 "${root}/standalone" "${root}/exact.bin")
file(SHA256 "${root}/export/payloads/0000000.bin" before)
file(SHA256 "${root}/exact.bin" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Standalone unchanged view differs")
endif()
run(1 view-export --format sci0 "${root}/exact.bin" "${root}/standalone")
run(1 view-import --format sci0 "${root}/standalone" "${root}/exact.bin")
run(2 view-export --format sci1 "${root}/exact.bin" "${root}/bad")
run(2 view-import --format sci0 "${root}/standalone")
execute_process(COMMAND "${FIXTURE_WRITER}" --edit-png "${root}/export/views/0000000/loop-0-cel-0.png" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Could not edit PNG fixture")
endif()
run(0 view-import --format sci0 "${root}/export/views/0000000" "${root}/edited.bin")
run(0 import --format sci0 "${root}/export" "${root}/edited-game")
run(0 export --format sci0 "${root}/edited-game" "${root}/edited-export")
file(SHA256 "${root}/edited.bin" expected)
file(SHA256 "${root}/edited-export/payloads/0000000.bin" actual)
if(NOT expected STREQUAL actual OR expected STREQUAL before)
  message(FATAL_ERROR "PNG edit did not flow through CLI reconstruction")
endif()
file(REMOVE_RECURSE "${root}")
