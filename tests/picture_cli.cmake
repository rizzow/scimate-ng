file(REMOVE_RECURSE "${FIXTURE_DIR}")
file(MAKE_DIRECTORY "${FIXTURE_DIR}")
execute_process(COMMAND "${FIXTURE_WRITER}" --write-fixture "${FIXTURE_DIR}/picture.bin" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "fixture failed")
endif()
function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL expected)
    message(FATAL_ERROR "${ARGN}: ${result}: ${error}")
  endif()
endfunction()
run(0 picture-export "${FIXTURE_DIR}/picture.bin" "${FIXTURE_DIR}/bundle")
run(0 picture-import --format sci0 "${FIXTURE_DIR}/bundle" "${FIXTURE_DIR}/rebuilt.bin")
file(READ "${FIXTURE_DIR}/picture.bin" original HEX)
file(READ "${FIXTURE_DIR}/rebuilt.bin" rebuilt HEX)
if(NOT original STREQUAL rebuilt)
  message(FATAL_ERROR "picture CLI byte roundtrip failed")
endif()
run(1 picture-export "${FIXTURE_DIR}/picture.bin" "${FIXTURE_DIR}/bundle")
run(1 picture-import "${FIXTURE_DIR}/bundle" "${FIXTURE_DIR}/rebuilt.bin")
run(2 picture-import "${FIXTURE_DIR}/bundle")
run(2 picture-export --format sci1 "${FIXTURE_DIR}/picture.bin" "${FIXTURE_DIR}/bad")
