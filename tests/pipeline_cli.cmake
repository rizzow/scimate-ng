string(RANDOM LENGTH 12 suffix)
set(root "${FIXTURE_DIR}/${suffix}")
file(MAKE_DIRECTORY "${root}")
execute_process(COMMAND "${FIXTURE_WRITER}" --write-fixture "${root}/source game" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Could not create pipeline fixtures")
endif()
function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${code}" STREQUAL "${expected}")
    message(FATAL_ERROR "Unexpected exit ${code} for ${ARGN}: ${output} ${error}")
  endif()
endfunction()
run(0 inspect --format sci0 "${root}/source game")
run(0 export --format sci0 "${root}/source game" "${root}/export")
run(0 disassemble --format sci0 "${root}/export/payloads/0000003.bin")
run(1 disassemble --format sci0 "${root}/export/payloads/0000001.bin")
run(2 disassemble --format sci1 "${root}/export/payloads/0000003.bin")
file(READ "${root}/export/scripts/0000003.asm" listing)
if(NOT listing MATCHES "ret" OR NOT listing MATCHES "not decompiled SCI source")
  message(FATAL_ERROR "Readable script listing missing or incorrectly described")
endif()
if(NOT EXISTS "${root}/export/scripts/0000001.error.txt")
  message(FATAL_ERROR "Malformed script export lacks diagnostic")
endif()
run(0 import --format sci0 "${root}/export" "${root}/rebuilt")
foreach(name resource.map resource.001 resource.063)
  file(SHA256 "${root}/source game/${name}" original)
  file(SHA256 "${root}/rebuilt/${name}" rebuilt)
  if(NOT original STREQUAL rebuilt)
    message(FATAL_ERROR "Byte round-trip mismatch: ${name}")
  endif()
endforeach()
run(1 import --format sci0 "${root}/export" "${root}/source game")
run(1 export --format sci0 "${root}/source game" "${root}/export")
run(2 export --format sci0 "${root}/source game")
run(2 import --format sci1 "${root}/export" "${root}/wrong")
file(WRITE "${root}/export/payloads/0000000.bin" "changed payload")
run(0 import --format sci0 "${root}/export" "${root}/edited")
run(0 export --format sci0 "${root}/edited" "${root}/re-export")
file(READ "${root}/re-export/payloads/0000000.bin" payload)
if(NOT payload STREQUAL "changed payload")
  message(FATAL_ERROR "CLI edited roundtrip failed")
endif()
file(WRITE "${root}/export/manifest.tsv" "invalid manifest")
run(1 import --format sci0 "${root}/export" "${root}/invalid")
if(EXISTS "${root}/invalid")
  message(FATAL_ERROR "Invalid import created output")
endif()
file(REMOVE_RECURSE "${root}")
