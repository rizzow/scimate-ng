file(REMOVE_RECURSE "${FIXTURE_DIR}")
file(MAKE_DIRECTORY "${FIXTURE_DIR}")
execute_process(COMMAND "${FIXTURE_WRITER}" --write-fixture "${FIXTURE_DIR}/sound.bin" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "sound fixture failed")
endif()
function(run expected)
  execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL expected)
    message(FATAL_ERROR "${ARGN}: ${result}: ${error}")
  endif()
endfunction()
run(0 sound-export "${FIXTURE_DIR}/sound.bin" "${FIXTURE_DIR}/sound")
run(0 sound-import "${FIXTURE_DIR}/sound" "${FIXTURE_DIR}/rebuilt.bin")
file(READ "${FIXTURE_DIR}/sound.bin" source HEX)
file(READ "${FIXTURE_DIR}/rebuilt.bin" rebuilt HEX)
if(NOT source STREQUAL rebuilt)
  message(FATAL_ERROR "sound CLI byte roundtrip failed")
endif()
run(0 resource-export sound 17 "${FIXTURE_DIR}/sound.bin" "${FIXTURE_DIR}/generic")
run(0 resource-import --format sci0 "${FIXTURE_DIR}/generic" "${FIXTURE_DIR}/generic.bin")
run(0 resource-export memory 17 "${FIXTURE_DIR}/sound.bin" "${FIXTURE_DIR}/raw")
run(0 resource-import "${FIXTURE_DIR}/raw" "${FIXTURE_DIR}/raw.bin")
file(READ "${FIXTURE_DIR}/raw.bin" raw HEX)
if(NOT source STREQUAL raw)
  message(FATAL_ERROR "binary CLI byte roundtrip failed")
endif()
run(1 font-import "${FIXTURE_DIR}/sound" "${FIXTURE_DIR}/wrong.bin")
run(1 sound-export "${FIXTURE_DIR}/sound.bin" "${FIXTURE_DIR}/sound")
run(1 sound-import "${FIXTURE_DIR}/sound" "${FIXTURE_DIR}/rebuilt.bin")
run(2 resource-export unknown 17 "${FIXTURE_DIR}/sound.bin" "${FIXTURE_DIR}/unknown")
run(2 resource-export sound 2048 "${FIXTURE_DIR}/sound.bin" "${FIXTURE_DIR}/range")
run(2 resource-export sound 17 "${FIXTURE_DIR}/sound.bin")
run(2 sound-export --format sci1 "${FIXTURE_DIR}/sound.bin" "${FIXTURE_DIR}/bad")
